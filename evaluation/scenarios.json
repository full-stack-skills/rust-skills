    {
      "id": "concurrency-cpu-parallelism",
      "prompt": "This Tokio service performs CPU-heavy image transforms inside async tasks. Choose an execution model that preserves I/O responsiveness and enforces an overload budget.",
      "expected_skills": ["rust-concurrency", "rust-performance"],
      "assertions": ["distinguishes_io_concurrency_from_cpu_parallelism", "selects_bounded_cpu_execution", "defines_backpressure", "measures_runtime_impact"]
