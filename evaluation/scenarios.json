      "expected_skills": ["rust-observability"],
      "assertions": ["removes_unbounded_labels", "uses_route_templates", "defines_sli_aligned_metrics", "validates_cardinality_budget"]
    },
    {
      "id": "performance-cpu-regression",
      "prompt": "A parser became 20% slower. Establish a reproducible Criterion benchmark, profile CPU time, identify the hot path, optimize it, and prove the regression is fixed.",
      "expected_skills": ["rust-performance", "rust-testing"],
      "assertions": ["records_baseline_and_hypothesis", "controls_benchmark_noise", "profiles_before_optimizing", "reports_before_after_evidence"]
    },
    {
      "id": "performance-memory-size",
      "prompt": "Reduce peak memory and release binary size for this Rust daemon without changing behavior or MSRV; include measurement commands and regression gates.",
      "expected_skills": ["rust-performance", "rust-cargo-build"],
      "assertions": ["separates_peak_memory_from_binary_size", "measures_representative_workload", "checks_profile_and_feature_tradeoffs", "preserves_behavior_and_msrv"]
