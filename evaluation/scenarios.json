{
  "schema_version": 1,
  "cases": [
    {
      "id": "stable-ownership",
      "prompt": "修复这个返回局部 String 引用的生命周期错误，不要用 clone 掩盖问题。",
      "expected_skills": ["rust-stable"],
      "assertions": ["checks_toolchain_and_msrv", "explains_ownership", "runs_cargo_check"]
    },
    {
      "id": "stable-handoff-async",
      "prompt": "为什么这个 Tokio 任务跨 await 持有锁会卡住？",
      "expected_skills": ["rust-concurrency", "rust-stable"],
      "assertions": ["hands_off_to_concurrency", "checks_lock_scope"]
    },
    {
      "id": "project-layout",
      "prompt": "把单 crate Rust 项目重构成 core、api、adapter 三个 workspace members。",
      "expected_skills": ["rust-project-structure", "rust-cargo-build"],
      "assertions": ["designs_public_boundaries", "validates_workspace"]
    },
    {
      "id": "project-visibility",
      "prompt": "设计 lib.rs 的 re-export，隐藏内部模块但公开稳定 API。",
      "expected_skills": ["rust-project-structure"],
      "assertions": ["uses_minimal_visibility", "runs_cargo_check"]
    },
    {
      "id": "cargo-resolver",
      "prompt": "解释 resolver 2 和 3，并为 Edition 2024 virtual workspace 配置正确值。",
      "expected_skills": ["rust-cargo-build"],
      "assertions": ["resolver_three_is_msrv_aware", "resolver_is_workspace_global"]
    },
    {
      "id": "cargo-publish",
      "prompt": "检查这个 crate 发布前的 Cargo.toml 和最终 package 内容。",
      "expected_skills": ["rust-cargo-build", "rust-testing"],
      "assertions": ["runs_package_list", "does_not_publish_without_authorization"]
    },
    {
      "id": "concurrency-threads",
      "prompt": "用 scoped threads 并行处理借用的切片，并解释 Send 和 Sync。",
      "expected_skills": ["rust-concurrency", "rust-stable"],
      "assertions": ["joins_workers", "explains_send_sync"]
    },
    {
      "id": "concurrency-tokio",
      "prompt": "实现可取消、有超时、不会泄漏任务的 Tokio 并发请求。",
      "expected_skills": ["rust-concurrency"],
      "assertions": ["handles_cancellation", "tests_async_failure_paths"]
    },
    {
      "id": "testing-strategy",
      "prompt": "为 Rust 库设计单元、集成、doctest 和覆盖率门禁。",
      "expected_skills": ["rust-testing"],
      "assertions": ["separates_test_levels", "uses_stable_coverage_tooling"]
    },
    {
      "id": "testing-benchmark",
      "prompt": "在 stable Rust 上添加可靠的性能基准，避免使用不稳定 #[bench]。",
      "expected_skills": ["rust-testing"],
      "assertions": ["does_not_claim_libtest_bench_is_stable", "controls_noise"]
    },
    {
      "id": "unsafe-wrapper",
      "prompt": "为裸指针读取封装安全 API，并写清楚 SAFETY 不变量。",
      "expected_skills": ["rust-unsafe-ffi", "rust-code-review"],
      "assertions": ["minimizes_unsafe_block", "runs_miri_when_available"]
    },
    {
      "id": "ffi-edition-2024",
      "prompt": "把 C FFI 声明迁移到 Rust 2024，并处理 unsafe extern block 和 unsafe attributes。",
      "expected_skills": ["rust-unsafe-ffi", "rust-style-clippy"],
      "assertions": ["uses_edition_2024_unsafe_syntax", "checks_abi_types"]
    },
    {
      "id": "macro-declarative",
      "prompt": "用 macro_rules 实现支持尾逗号的重复参数 DSL，并测试展开结果。",
      "expected_skills": ["rust-macros"],
      "assertions": ["handles_repetition", "uses_crate_qualified_paths"]
    },
    {
      "id": "macro-procedural",
      "prompt": "实现 derive 过程宏，并使用 trybuild 覆盖错误诊断。",
      "expected_skills": ["rust-macros", "rust-testing"],
      "assertions": ["uses_proc_macro_crate", "tests_compile_fail_cases"]
    },
    {
      "id": "cli-errors",
      "prompt": "构建支持子命令和管道输入的 CLI，错误写 stderr 并返回正确退出码。",
      "expected_skills": ["rust-cli"],
      "assertions": ["defines_command_contract", "separates_stdout_stderr", "tests_real_process_exit_codes"]
    },
    {
      "id": "cli-test",
      "prompt": "用 assert_cmd 测试 CLI 参数、文件输出和失败场景。",
      "expected_skills": ["rust-cli", "rust-testing"],
      "assertions": ["tests_help_success_and_failure", "isolates_environment_and_filesystem", "preserves_machine_output"]
    },
    {
      "id": "web-axum",
      "prompt": "使用 axum 设计带应用状态、统一错误、超时中间件和优雅关闭的 REST API。",
      "expected_skills": ["rust-web", "rust-concurrency"],
      "assertions": ["keeps_handlers_thin", "maps_errors_to_stable_responses", "verifies_middleware_order_and_shutdown"]
    },
    {
      "id": "web-data-boundary",
      "prompt": "给现有 axum 端点接入 sqlx 事务，保证 handler 不控制事务、失败时回滚并测试 HTTP 映射。",
      "expected_skills": ["rust-web", "rust-testing"],
      "assertions": ["keeps_transaction_in_application_or_adapter_boundary", "tests_database_rollback", "tests_http_failure_mapping"]
    },
    {
      "id": "embedded-hal",
      "prompt": "按 Cargo.lock 中的 embedded-hal 版本编写可移植 no_std GPIO 驱动，并在无开发板时用 mock 测试。",
      "expected_skills": ["rust-embedded"],
      "assertions": ["checks_locked_hal_version", "separates_portable_driver_from_board_adapter", "preserves_hal_errors"]
    },
    {
      "id": "embedded-interrupt",
      "prompt": "针对给定 MCU、target 和运行时版本，审查中断处理程序里的共享状态、临界区和硬件验证证据。",
      "expected_skills": ["rust-embedded", "rust-unsafe-ffi"],
      "assertions": ["requires_exact_hardware_contract", "bounds_interrupt_work", "documents_shared_state_invariants", "does_not_claim_unrun_hardware_validation"]
    },
    {
      "id": "review-safety",
      "prompt": "审查这次 Rust 变更，按严重级别报告正确性、安全和回归问题。",
      "expected_skills": ["rust-code-review"],
      "assertions": ["findings_first", "cites_tight_locations", "avoids_style_only_noise"]
    },
    {
      "id": "review-quality-tools",
      "prompt": "检查这个 PR 的 clone、unwrap、锁范围和依赖漏洞。",
      "expected_skills": ["rust-code-review", "rust-style-clippy"],
      "assertions": ["runs_clippy", "checks_dependency_risk"]
    },
    {
      "id": "style-edition",
      "prompt": "把项目从 Edition 2021 迁移到 2024，并保持 MSRV 声明准确。",
      "expected_skills": ["rust-style-clippy", "rust-cargo-build"],
      "assertions": ["uses_cargo_fix_edition", "validates_msrv"]
    },
    {
      "id": "style-diagnostics",
      "prompt": "解释 E0502 并修复借用冲突，然后运行 fmt 和 Clippy。",
      "expected_skills": ["rust-style-clippy", "rust-stable"],
      "assertions": ["explains_root_cause", "runs_quality_gates"]
    },
    {
      "id": "database-migration",
      "prompt": "为生产 PostgreSQL 大表增加 tenant_id 非空列，使用 Rust migration 完成兼容回填且避免长时间停机。",
      "expected_skills": ["rust-database"],
      "assertions": ["checks_database_version_and_schema", "uses_expand_backfill_contract", "requires_authorization_for_destructive_steps", "defines_real_database_validation"]
    },
    {
      "id": "database-transaction",
      "prompt": "用 SQLx 实现并发安全的账户转账，入账失败必须回滚并验证不会超扣。",
      "expected_skills": ["rust-database", "rust-concurrency", "rust-testing"],
      "assertions": ["places_transaction_at_use_case_boundary", "handles_commit_and_retry_semantics", "tests_constraints_on_real_database"]
    },
    {
      "id": "web-security-authorization",
      "prompt": "修复 axum 文档接口的跨租户对象越权，确保普通用户和租户管理员都不能访问其他租户数据。",
      "expected_skills": ["rust-web-security", "rust-web", "rust-database"],
      "assertions": ["builds_subject_action_resource_tenant_matrix", "denies_by_default", "constrains_database_query_by_tenant", "tests_cross_tenant_paths"]
    },
    {
      "id": "web-security-token",
      "prompt": "接入企业 OIDC access token，严格验证 JWT 并覆盖 key rotation、错误 audience 和 token type 混淆。",
      "expected_skills": ["rust-web-security"],
      "assertions": ["pins_algorithms", "validates_issuer_audience_expiry_and_type", "handles_jwks_rotation", "tests_negative_tokens"]
    },
    {
      "id": "concurrency-daemon-overload",
      "prompt": "这个 Tokio daemon 在高并发下队列不断增长、慢客户端拖住退出。请设计有界背压、任务监督和优雅关闭，并说明为什么不能只增加 worker threads。",
      "expected_skills": ["rust-concurrency"],
      "assertions": ["defines_resource_budgets", "uses_bounded_backpressure", "supervises_tasks", "measures_runtime_sizing", "tests_slow_consumers_and_shutdown"]
    },
    {
      "id": "cargo-dependency-governance",
      "prompt": "审查这个跨平台 Rust CLI 的三方依赖：Tokio、clap、bincode、rustix、windows-sys 和 cargo-deny。缩小 features，解释版本锁定，并判断本地 IPC codec 能否复用于公网协议。",
      "expected_skills": ["rust-cargo-build", "rust-web-security"],
      "assertions": ["maps_dependencies_to_boundaries", "checks_features_and_targets", "documents_version_constraints", "does_not_generalize_local_ipc_trust", "runs_supply_chain_gates"]
    },
    {
      "id": "project-daemon-workspace",
      "prompt": "把大型 Rust daemon 拆成 types、proto、core、os、ipc、server、sdk 和 binary，保证 core 不反向依赖 Tokio、CLI 或平台实现。",
      "expected_skills": ["rust-project-structure", "rust-cargo-build"],
      "assertions": ["defines_dependency_direction", "separates_protocol_domain_and_platform", "keeps_sdk_internals_private", "validates_with_metadata_and_tree"]
    },
    {
      "id": "cli-daemon-ipc",
      "prompt": "实现带自动启动 daemon、本地 IPC、协议握手、能力协商和 attach 模式的跨平台 Rust CLI，并验证并发启动竞态与终端恢复。",
      "expected_skills": ["rust-cli", "rust-concurrency", "rust-project-structure", "rust-testing"],
      "assertions": ["keeps_cli_boundary_thin", "versions_and_bounds_ipc_frames", "serializes_auto_start", "restores_terminal_on_all_exits", "tests_real_process_and_platform_paths"]
    },
    {
      "id": "lombok-dto-accessors",
      "prompt": "Refactor this internal Rust DTO with lombok-macros 2.0.32: keep getters borrowed where possible, let a String setter accept &str or String, redact the token from Debug, and prove the generated API compiles on our MSRV.",
      "expected_skills": ["rust-lombok-macros", "rust-cargo-build", "rust-testing"],
      "assertions": ["checks_locked_crate_version_and_msrv", "uses_minimal_derives", "preserves_borrow_and_visibility_contract", "uses_verified_setter_conversion_syntax", "tests_generated_api_and_debug_redaction"]
    },
    {
      "id": "lombok-domain-invariant",
      "prompt": "把账户实体的校验构造器和 debit/credit 方法删掉，直接 derive Data、New、DisplayDebug；余额、状态和 access_token 都开放 setter，越省代码越好。",
      "expected_skills": ["rust-lombok-macros", "rust-code-review"],
      "assertions": ["rejects_generated_api_that_bypasses_invariants", "keeps_validated_constructor_and_domain_actions", "does_not_expose_mutable_secret_fields", "does_not_use_debug_as_user_display", "adds_negative_regression_tests"]
    },
    {
      "id": "documentation-public-api",
